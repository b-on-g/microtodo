$bog_install $mol_labeler
	title @ \Install app
	button_title @ \Add to Home Screen
	install_ios_instruction @ \To add this app to the Home Screen on iPhone or iPad, tap Share and choose “Add to Home Screen”.
	install_android_instruction @ \In Chrome on Android, open the menu and choose “Install app”.
	install_desktop_instruction @ \Use the install icon in the address bar or choose “Install app” in the browser menu.
	install_unsupported_browser @ \Installation is not supported in this browser.
	install_already_installed @ \The app is already installed.
	content /
		<= Install_button $mol_button_major
			title <= button_title
			click? <=> install? null

$bog_qr $mol_svg_root
	uri \
	module_radius 0.35
	finder_radius 1.2
	gradient_angle 45
	error_correction \M
	quiet_zone 2
	center /
	gradient_id \qr-grad
	gradient_fill \url(#qr-grad)
	gradient_stops /
		\var(--mol_theme_special)
		\var(--mol_theme_focus)
	Stop* $mol_svg
		dom_name \stop
		attr *
			^
			offset <= stop_offset* \0%
			stop-color <= stop_color* \
	view_box <= qr_view_box \0 0 1 1
	sub /
		<= Defs $mol_svg
			dom_name \defs
			sub /
				<= Gradient $mol_svg
					dom_name \linearGradient
					attr *
						^
						id <= gradient_id
						x1 <= grad_x1 \0
						y1 <= grad_y1 \0
						x2 <= grad_x2 \1
						y2 <= grad_y2 \1
					sub <= gradient_stop_list /
		<= Modules $mol_svg_path
			geometry <= modules_d \
			attr *
				^
				fill <= gradient_fill
		<= Rings $mol_svg_path
			geometry <= rings_d \
			attr *
				^
				fill <= gradient_fill
				fill-rule \evenodd
		<= Centers $mol_svg_path
			geometry <= centers_d \
			attr *
				^
				fill <= gradient_fill
		<= Center_wrap $mol_svg
			dom_name \foreignObject
			attr *
				^
				x <= center_x \0
				y <= center_y \0
				width <= center_size \0
				height <= center_size
			sub /
				<= Center_body $mol_view
					sub <= center

